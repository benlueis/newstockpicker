<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stockpicker.afternoon-scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/.venv/bin/python</string>
    <string>__PROJECT_ROOT__/scripts/afternoon_scan.py</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>14</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/data/logs/afternoon.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/data/logs/afternoon.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>BARK_URL</key>
    <string>https://api.day.app/hen9ePKgKGwLGi4VLvwrJn/</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
