# ============================================================================
# newstockpicker 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================================

# ── 数据源配置 ──────────────────────────────────
# 可选值: tencent, baostock, pytdx
DATA_SOURCE=tencent

# ── 缓存后端配置 ──────────────────────────────
# 可选值: sqlite, parquet
CACHE_BACKEND=sqlite

# ── Bark 推送配置 ──────────────────────────────
# 用于向 iPhone 发送扫描结果通知
# 格式: https://api.day.app/YOUR_KEY/
# BARK_URL=https://api.day.app/YOUR_KEY/

# ── 时区配置 ──────────────────────────────────
TZ=Asia/Shanghai

# ── 并发配置 ──────────────────────────────────
# 缓存更新并发数
WORKERS=6

# ── 重试配置 ──────────────────────────────────
# 扫描失败重试次数
MAX_RETRIES=3

# 重试间隔（秒）
RETRY_DELAY=5

# ── 超时配置 ──────────────────────────────────
# 数据源请求超时（秒）
REQUEST_TIMEOUT=10

# ── 日志配置 ──────────────────────────────────
# 可选值: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO